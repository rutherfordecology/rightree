    "Elaeocarpus", "Fuscospora", "Ixerba", "Knightia", "Laurelia", "Libocedrus", "Litsea", "Lophozonia",
    "Nestegis", "Pectinopitys", "Phyllocladus", "Podocarpus", "Prumnopitys", "Rhopalostylis", "Vitex"
  ],
  "woody": [
    "Alsophila", "Aristotelia", "Brachyglottis", "Carpodetus", "Coprosma", "Cordyline", "Coriaria",
    "Corynocarpus", "Cyathea", "Dicksonia", "Fuchsia", "Geniostoma", "Griselinia", "Hedycarya", "Hoheria",
    "Kunzea", "Leptospermum", "Melicope", "Melicytus", "Metrosideros", "Myrsine", "Olearia", "Ozothamnus",
    "Pennantia", "Piper", "Pittosporum", "Plagianthus", "Pseudopanax", "Pterophylla", "Schefflera",
    "Streblus", "Weinmannia"
  ]
}
